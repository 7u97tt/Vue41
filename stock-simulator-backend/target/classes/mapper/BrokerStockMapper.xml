<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.stocksim.mapper.BrokerStockMapper">

    <resultMap id="BrokerStockMap" type="com.stocksim.entity.BrokerStock">
        <id column="id" property="id"/>
        <result column="stock_code" property="stockCode"/>
        <result column="can_borrow_count" property="canBorrowCount"/>
    </resultMap>

    <select id="selectByStockCode" resultMap="BrokerStockMap">
        SELECT id, stock_code, can_borrow_count
        FROM broker_stock
        WHERE stock_code = #{stockCode}
        LIMIT 1
    </select>

    <select id="selectAll" resultMap="BrokerStockMap">
        SELECT id, stock_code, can_borrow_count
        FROM broker_stock
        ORDER BY stock_code
    </select>

    <update id="updateCanBorrowCount">
        UPDATE broker_stock
        SET can_borrow_count = #{canBorrowCount}
        WHERE stock_code = #{stockCode}
    </update>
</mapper>
